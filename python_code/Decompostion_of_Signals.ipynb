    "tonic_signals = []\n",
    "phasic_signals = []\n",
    "\n",
    "# Dictionary of participant IDs\n",
    "subject_ids = list(dict.fromkeys([col.split('_')[0] for col in wesad_data.columns]))\n",
    "\n",
    "for subject_id in subject_ids:\n",
    "    eda_col = f'{subject_id}_EDA'\n",
    "    label_col = f'{subject_id}_Label'\n",
    "\n",
    "    eda_signal = wesad_data[eda_col]\n",
    "    labels = wesad_data[label_col]\n",
    "\n",
    "    # Apply cvxEDA decomposition\n",
    "    r, p, t, l, d, e, obj = cvxeda.cvxEDA(eda_signal, 1.0 / 4)\n",
    "        \n",
    "    # Build the structured DataFrame for the current participant\n",
    "    tonic_dataframe = pd.DataFrame({\n",
    "            f'{subject_id}_Tonic': t,\n",
    "            f'{subject_id}_Label': labels\n",
    "        })\n",
    "\n",
    "    phasic_dataframe = pd.DataFrame({\n",
    "                    f'{subject_id}_Phasic': p,\n",
    "                    f'{subject_id}_Label': labels\n",
    "                })\n",
    "        \n",
    "    tonic_signals.append(tonic_dataframe)\n",
    "    phasic_signals.append(phasic_dataframe)\n",
    "    \n",
    "\n",
    "        \n",
    "\n",
    "\n",
    "# Combine all subject results\n",
    "#final_filtered_data = pd.concat(filtered_signals, axis=1)"
   ]
